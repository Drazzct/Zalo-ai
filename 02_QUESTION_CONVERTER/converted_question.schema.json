{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.datamate/converter/converted_question-v1.schema.json",
  "title": "DataMate biz_101 — Manual Converter Output v1",
  "description": "No answer labels, reference SQL, or execution outputs. Downstream Coder Input Contract is a separate step.",
  "type": "object",
  "required": [
    "converter_version",
    "question_id",
    "business_id",
    "original_question",
    "as_of_date",
    "semantic_analysis",
    "normalized_question",
    "intent",
    "temporal_constraints",
    "required_business_rules",
    "ambiguities",
    "conditional_risks",
    "status",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "converter_version": {
      "type": "string"
    },
    "question_id": {
      "type": "string",
      "pattern": "^q_[a-f0-9]+$"
    },
    "business_id": {
      "const": "biz_101"
    },
    "original_question": {
      "type": "string",
      "minLength": 1
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "semantic_analysis": {
      "type": "object",
      "required": [
        "user_goal",
        "interpretation",
        "semantic_type",
        "question_phrase"
      ],
      "properties": {
        "user_goal": {
          "type": "string"
        },
        "interpretation": {
          "type": "string"
        },
        "semantic_type": {
          "type": "string"
        },
        "question_phrase": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "normalized_question": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "object",
      "required": [
        "metric",
        "aggregation",
        "measure_column",
        "group_by",
        "filters",
        "sort",
        "top_k",
        "entity",
        "requested_unit",
        "expected_answer_type",
        "needs_join",
        "required_relations",
        "identity_policy",
        "price_semantics"
      ],
      "properties": {
        "metric": {
          "enum": [
            "valid_order_count",
            "net_sales_revenue",
            "sold_base_quantity",
            "unit_selling_price"
          ]
        },
        "aggregation": {
          "enum": [
            "count_distinct",
            "sum",
            "argmax_by_group",
            "price_observation"
          ]
        },
        "measure_column": {
          "type": "string"
        },
        "group_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "operator",
              "value"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "operator": {
                "enum": [
                  "between_inclusive",
                  "in"
                ]
              },
              "value": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "type": "string"
              },
              "source_rule": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "metric",
              "direction"
            ],
            "properties": {
              "metric": {
                "type": "string"
              },
              "direction": {
                "enum": [
                  "asc",
                  "desc"
                ]
              },
              "purpose": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "top_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "entity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "canonical_name",
                "observed_aliases"
              ],
              "properties": {
                "kind": {
                  "const": "product"
                },
                "canonical_name": {
                  "type": "string"
                },
                "observed_aliases": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "requested_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_answer_type": {
          "enum": [
            "number",
            "string",
            "date"
          ]
        },
        "needs_join": {
          "type": "boolean"
        },
        "required_relations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identity_policy": {
          "type": [
            "object",
            "null"
          ]
        },
        "price_semantics": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "temporal_constraints": {
      "type": "object",
      "required": [
        "original_expression",
        "normalization_kind",
        "reference_date",
        "start_date",
        "end_date",
        "inclusive_start",
        "inclusive_end",
        "timezone",
        "restrict_to_as_of_date"
      ],
      "properties": {
        "original_expression": {
          "type": "string"
        },
        "normalization_kind": {
          "enum": [
            "calendar_quarter",
            "calendar_month",
            "relative_previous_day",
            "relative_today",
            "explicit_day"
          ]
        },
        "reference_date": {
          "type": "string",
          "format": "date"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "inclusive_start": {
          "const": true
        },
        "inclusive_end": {
          "const": true
        },
        "timezone": {
          "type": "string"
        },
        "restrict_to_as_of_date": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "required_business_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "applies"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "applies": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conditional_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "ready",
        "needs_clarification",
        "unanswerable_candidate"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "question_file",
        "business_readme",
        "rulebook",
        "schema_file",
        "manual_annotation"
      ],
      "properties": {
        "question_file": {
          "type": "string"
        },
        "business_readme": {
          "type": "string"
        },
        "rulebook": {
          "type": "string"
        },
        "schema_file": {
          "type": "string"
        },
        "manual_annotation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
